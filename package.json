{
  "name": "jevy",
  "private": true,
  "version": "0.0.0",
  "description": "AI-assisted testing that produces plain Playwright code",
  "license": "MIT",
  "author": "Adam Gencel",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter \"./packages/*\" run typecheck",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "changeset": "changeset"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "catalog:",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "catalog:",
    "typescript-eslint": "8.72.1",
    "vitest": "catalog:"
  }
}
