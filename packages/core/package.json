{
  "name": "@jevyjs/core",
  "private": true,
  "version": "0.0.0",
  "description": "Decider interface, decision cache, verdicts, snapshot hashing, redaction, and config for Jevy",
  "license": "MIT",
  "author": "Adam Gencel",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdamGencel/jevy.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/AdamGencel/jevy/issues"
  },
  "homepage": "https://github.com/AdamGencel/jevy/tree/main/packages/core",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
