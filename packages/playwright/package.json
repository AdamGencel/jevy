{
  "name": "@jevyjs/playwright",
  "private": true,
  "version": "0.0.0",
  "description": "Playwright integration for Jevy: the toSatisfy matcher and its fixtures, page snapshots with secret fields blanked, and the report.json reporter",
  "license": "MIT",
  "author": "Adam Gencel",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "import": "./dist/reporter.js",
      "default": "./dist/reporter.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdamGencel/jevy.git",
    "directory": "packages/playwright"
  },
  "bugs": {
    "url": "https://github.com/AdamGencel/jevy/issues"
  },
  "homepage": "https://github.com/AdamGencel/jevy/tree/main/packages/playwright",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@jevyjs/core": "workspace:*",
    "@jevyjs/deciders-llm": "workspace:*",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.49.0"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
