.DS_Store
node_modules/
dist/
*.tsbuildinfo
coverage/
*.log
pnpm-publish-summary.json

# Secrets. Jev keys are read from TYPESAFE_API_KEY and must never be committed.
.env
.env.*
!.env.example

# Decision JSONL under .jevy/decisions is meant to be committed.
# Lock files, in-progress writes, and the last-run bookkeeping file are not.
.jevy/**/.locks/
.jevy/**/.last-run.json
.jevy/**/*.tmp
